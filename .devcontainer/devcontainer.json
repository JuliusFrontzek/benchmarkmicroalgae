{
    "name": "MATLAB + Python (uv) + Claude",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "matlab",
    "mounts": [
        // Mount SSH keys for git access
        "type=bind,source=${localEnv:HOME}/.ssh,target=/home/matlab/.ssh,readonly",
        // Bind the host's Claude config/session dir for persistence
        "type=bind,source=${localEnv:HOME}/.claude,target=/home/matlab/.claude"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/home/matlab/project/.venv/bin/python",
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "mathworks.language-matlab",
                "ms-python.python",
                "charliermarsh.ruff",
                "anthropic.claude-code"
            ]
        }
    },
    "containerEnv": {
        "MLM_LICENSE_FILE": "27004@lm-matlab.hrz.tu-chemnitz.de",
        "LD_LIBRARY_PATH": "/opt/matlab/R2025b/bin/glnxa64:/usr/local/cuda/lib64",
        "CC": "gcc",
        "CXX": "g++",
        "CUDA_HOME": "/usr/local/cuda"
    },
    "runArgs": [
        "--shm-size=512mb",
        "--network=host",
        "--gpus=all"
    ],
    "postStartCommand": "python3 /workspaces/benchmarkmicroalgae/.devcontainer/select_free_gpu.py --set-bashrc"
}
